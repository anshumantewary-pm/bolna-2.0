# Claude credentials: an API key here, or run `ant auth login` once instead.
ANTHROPIC_API_KEY=

# Model and speed settings (defaults shown).
VOICE_AGENT_MODEL=claude-opus-5-5
VOICE_AGENT_EFFORT=low
# 1 = fast mode (about 2.5x faster output, 2x price). Needs fast-mode access on your account.
VOICE_AGENT_FAST=0
# 1 = server-side refusal fallbacks (the API retries a declined request on a fallback model).
VOICE_AGENT_FALLBACKS=1

# Seconds a tool may run before the agent plays a filler line ("One moment...").
VOICE_AGENT_FILLER_AFTER_S=1.0
# Hard timeout per tool call, in seconds.
VOICE_AGENT_TOOL_TIMEOUT_S=3.0
